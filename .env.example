# ProofPay Environment Variables Example
# Duplicate this file to .env and populate with your PayPal Sandbox and API credentials.
# NEVER commit .env to version control.

# PayPal Sandbox Credentials (from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (from webhook setup pointing to your public endpoint e.g. via cloudflared)
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# PayPal Mock Mode: ONLY set to "true" for isolated local simulation when credentials are unavailable.
# If credentials are missing and PAYPAL_MOCK is not true, the server fails loudly with setup instructions.
# Spike scripts and the final demo will refuse to run if PAYPAL_MOCK is true.
PAYPAL_MOCK=false

# Database Connection (Postgres via docker-compose or hosted Render Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proofpay

# Mandate Security Secret (HMAC-SHA256 secret for signing job payment mandates)
MANDATE_SIGNING_SECRET=change_this_to_a_secure_random_string_in_production_32_chars_min

# Model Configuration (Google Gemini via Vercel AI SDK)
MODEL_ID=gemini-3.8-flash
MODEL_FALLBACK_ID=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Application Base URL (for redirects, callbacks, and cloudflared tunnels)
APP_BASE_URL=http://localhost:3000

# Configured PayPal Sandbox Accounts:
# - PAYPAL_SANDBOX_PAYEE_EMAIL: Read at runtime by the hosted web app at payout time (and as default non-demo payee on job creation when PAYPAL_MOCK=false)
# - PAYPAL_SANDBOX_PERSONAL_EMAIL / PAYPAL_SANDBOX_BUSINESS_EMAIL: Read only by local CLI scripts (pnpm demo:run, scripts/audit-secrets-literal.cjs)
PAYPAL_SANDBOX_PAYEE_EMAIL=your_sandbox_personal_payee_email_here
PAYPAL_SANDBOX_PERSONAL_EMAIL=your_sandbox_personal_account_email_here
PAYPAL_SANDBOX_BUSINESS_EMAIL=your_sandbox_business_account_email_here

# Hard Daily Cap on Real PayPal Sandbox Payouts
MAX_DAILY_REAL_PAYOUT_USD=25.00
MAX_DAILY_REAL_PAYOUT_COUNT=5

# Client IP Extraction: number of rightmost public X-Forwarded-For entries to skip as trusted proxies (integer 0..10, default: 0)
CLIENT_IP_TRUSTED_PROXY_HOPS=0

# Reviewer-only Client IP Diagnostic Endpoint (/api/debug/client-ip): returns 404 unless set to "true" (default: false)
ENABLE_DEBUG_CLIENT_IP=false

# Test-Only Role Header Override (x-proofpay-role): ignored in production unless set to "true" (default: false; set only in playwright.config.ts)
ENABLE_TEST_ROLE_HEADER=false
